# Local Postgres from docker-compose.yml (`make up`).
DATABASE_URL=postgresql://agentforge:agentforge@localhost:5433/agentforge

# Cloud alternative: when DB_HOST is set it overrides DATABASE_URL.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=agentforge
# DB_USERNAME=
# DB_PASSWORD=

# Downstream for report.publish / notify.post (`make mock`).
MOCK_EFFECTS_URL=http://localhost:8001

# Lease tuning (seconds) and poison-run limit.
# LEASE_SECONDS=30
# HEARTBEAT_SECONDS=10
# MAX_ATTEMPTS=3

# Optional host-visible report address when MOCK_EFFECTS_URL is container-only.
# MOCK_EFFECTS_PUBLIC_URL=http://127.0.0.1:18011

# Deterministic model and fixture settings (defaults are checked-in fixtures).
# REPOS_ROOT=/absolute/path/to/AgentForge/tests/fixtures
# MODEL_SCRIPT=/absolute/path/to/AgentForge/tests/fixtures/scripts/repo_analysis.yaml
# SANDBOX_IMAGE=python:3.12-alpine
# DEMO_MODE=false

# TestForge helper ports; not needed for the normal developer demo.
# TF_API_PORT=18010
# TF_EFFECTS_PORT=18011
# TF_PROJECT=agentforge-testforge
