# Local Postgres from docker-compose.yml (`make up`).
DATABASE_URL=postgresql://agentforge:agentforge@localhost:5433/agentforge

# Cloud alternative: when DB_HOST is set it overrides DATABASE_URL.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=agentforge
# DB_USERNAME=
# DB_PASSWORD=

# Downstream for report.publish / notify.post (`make mock`).
MOCK_EFFECTS_URL=http://localhost:8001

# Lease tuning (seconds) and poison-run limit.
# LEASE_SECONDS=30
# HEARTBEAT_SECONDS=10
# MAX_ATTEMPTS=3
